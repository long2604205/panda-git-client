<idea-plugin visibility="internal">
  <dependencies>
    <module name="intellij.platform.projectFrame" />
  </dependencies>
  <extensions defaultExtensionNs="com.intellij">
    <projectFrameCapabilitiesProvider
        implementation="com.pandagit.PandaGitProjectFrameCapabilitiesProvider" />
    <postStartupActivity implementation="com.pandagit.PandaGitInitialVfsRefreshActivity" />
    <postStartupActivity implementation="com.pandagit.PandaGitTextMateFileTypeActivity" />
  </extensions>
  <applicationListeners>
    <listener class="com.pandagit.PandaGitMenuListener" topic="com.intellij.ide.AppLifecycleListener" />
  </applicationListeners>
</idea-plugin>
